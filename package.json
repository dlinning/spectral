{
  "name": "spectral-pwa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PWA Spectrum Analyzer, Spectrogram, and Chromatic Musical Tuner; built with WebAssembly DSP",
  "scripts": {
    "build:wasm": "asc assembly/index.ts --target release -O3 --importMemory --initialMemory 256 --maximumMemory 512 --outFile public/wasm/spectral_dsp.wasm",
    "dev": "yarn build:wasm && vite",
    "build": "yarn build:wasm && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "assemblyscript": "^0.27.31",
    "jsdom": "^25.0.1",
    "prettier": "^3.10.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
